# ── Database ───────────────────────────────────────────────────────────────
# Omit locally to use the embedded demo database. Deployed environments REQUIRE it
# (production and preview refuse to start on demo storage). Runtime role: salut_app.
DATABASE_URL=
# Migrations only (owner role, direct non-pooled host). Never set on Vercel runtime.
# Use MIGRATION_DATABASE_URL for `npm run db:migrate` and the catalog import.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
SITE_URL=
INSTAGRAM_URL=
SALUT_ANALYTICS_ENABLED=
# Customer accounts are created already verified, with no email (anyone can register any address). Remove once Resend is configured.
SALUT_INSTANT_ACCOUNTS=

# ── Stripe (test first; live is gated) ─────────────────────────────────────
SALUT_STRIPE_TEST_ENABLED=
STRIPE_SECRET_KEY=            # sk_test_… in test mode
STRIPE_WEBHOOK_SECRET=        # whsec_… from the endpoint /api/stripe/webhook
# Live payments stay off until the owner approves. All three must be set deliberately:
# STRIPE_MODE=live   STRIPE_SECRET_KEY=sk_live_…   SALUT_LIVE_PAYMENTS_APPROVED=1
STRIPE_MODE=
SALUT_LIVE_PAYMENTS_APPROVED=

# ── Resend (transactional only) ────────────────────────────────────────────
SALUT_RESEND_TEST_ENABLED=
RESEND_API_KEY=
RESEND_FROM=                  # verified sender, e.g. "Salut Bon Bon Thé <commandes@your-domain>"
RESEND_TEST_RECIPIENT=        # test mode only ever reaches this address
STORE_NOTIFICATION_EMAIL=     # where new-order notices go
# Live email: RESEND_MODE=live and SALUT_LIVE_EMAIL_APPROVED=1
RESEND_MODE=
SALUT_LIVE_EMAIL_APPROVED=
# Protects /api/notifications/run (min 32 chars). Vercel Cron sends it automatically.
CRON_SECRET=

# ── Tests only (never set in deployed environments) ────────────────────────
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salut_test
# SALUT_EMAIL_CAPTURE_DIR=/tmp/salut-mails
