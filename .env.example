# Optional Neon connection string. Omit to use persistent local demo storage.
DATABASE_URL=
# Required for individual staff sign-in with DATABASE_URL. Use an HTTPS origin
# outside loopback and a randomly generated secret of at least 32 characters.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
SITE_URL=

# Optional verified official Instagram profile URL.
INSTAGRAM_URL=

# Optional first-party analytics. Leave disabled until privacy review.
SALUT_ANALYTICS_ENABLED=

# Test-only provider adapters. Keep disabled until the test workflow is configured.
SALUT_STRIPE_TEST_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SALUT_RESEND_TEST_ENABLED=
RESEND_API_KEY=
RESEND_FROM=
RESEND_TEST_RECIPIENT=
